# Copie para .env e preencha. O .env NUNCA vai para o git.

# ---- Servidor web ----
# Acesso pela rede: http://NOME-DO-SERVIDOR:3003 (no modo produção, usado pelo servidor\instalar.bat)
PORT=3003

# Lojas que este servidor pode ver: "todas" (todas as configuradas abaixo)
# ou lista separada por vírgula: parque10, pontanegra, moradadosol, monte, cd, flores
# Ex.: servidor da Ponta Negra →  LOJAS_PERMITIDAS=pontanegra
LOJAS_PERMITIDAS=todas

# ---- Acesso ao SISMOURA (SQL Server, somente leitura) ----
SISMOURA_USUARIO=
# Use aspas simples se a senha tiver #, espaço ou aspas
SISMOURA_SENHA=''

# Uma loja só é usada se <LOJA>_SERVIDOR estiver preenchido.
# Basta configurar as lojas que este servidor pode acessar.
# <LOJA>_USUARIO / <LOJA>_SENHA são opcionais (sobrescrevem os gerais).
PARQUE10_SERVIDOR=
PARQUE10_BANCO=

PONTANEGRA_SERVIDOR=
PONTANEGRA_BANCO=

MORADADOSOL_SERVIDOR=
MORADADOSOL_BANCO=

MONTE_SERVIDOR=
MONTE_BANCO=

CD_SERVIDOR=
CD_BANCO=

FLORES_SERVIDOR=
FLORES_BANCO=
FLORES_USUARIO=
FLORES_SENHA=''
